# open-dynamic-workflows — environment variables (all optional).
# Real configuration lives in ~/.odw/config.json; these are convenience fallbacks.
# NEVER commit real keys. This file documents names only.

# Port the daemon binds on 127.0.0.1 (default 7345)
ODW_DAEMON_PORT=7345

# Override the daemon home directory (config, sqlite, logs, pid). Default: ~/.odw
# ODW_HOME=/custom/path/.odw

# Model provider API keys (fallback if not set in ~/.odw/config.json apiKeys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# No key needed for local models — set models.default to "ollama:<model>" in config.json
