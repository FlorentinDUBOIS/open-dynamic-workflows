{
  "name": "odw-vscode",
  "displayName": "Open Dynamic Workflows",
  "description": "Plan, run, and monitor multi-agent workflows from VS Code via the local odw daemon.",
  "version": "0.1.0",
  "publisher": "open-dynamic-workflows",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "odw",
          "title": "Dynamic Workflows",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "odw": [
        {
          "id": "odwWorkflows",
          "name": "Workflows"
        }
      ]
    },
    "commands": [
      { "command": "odw.runWorkflow", "title": "ODW: Run Workflow" },
      { "command": "odw.showDashboard", "title": "ODW: Show Dashboard" },
      { "command": "odw.pauseWorkflow", "title": "ODW: Pause Workflow" },
      { "command": "odw.resumeWorkflow", "title": "ODW: Resume Workflow" },
      { "command": "odw.stopWorkflow", "title": "ODW: Stop Workflow" },
      { "command": "odw.installDaemon", "title": "ODW: Install Local Daemon" }
    ],
    "configuration": {
      "title": "Open Dynamic Workflows",
      "properties": {
        "odw.daemonPort": {
          "type": ["number", "null"],
          "default": null,
          "description": "Port of the local odw daemon HTTP API. Leave unset to use ODW_DAEMON_PORT or the default 7345."
        },
        "odw.daemonToken": {
          "type": "string",
          "default": "",
          "description": "Bearer token for the local odw daemon. Leave empty to use ODW_DAEMON_TOKEN or ~/.odw/daemon.token."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.js\""
  }
}
