{
  "name": "open-dynamic-workflows",
  "version": "0.1.0",
  "private": true,
  "description": "Dynamic multi-agent workflows for any AI coding agent — plan, orchestrate, verify.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/run-workspace-script.mjs test",
    "test:external": "node scripts/run-node-tests.mjs Tests/odw-endurance.test.mjs Tests/odw-real-projects/*.test.mjs",
    "coverage": "node scripts/run-workspace-script.mjs coverage",
    "lint": "eslint .",
    "build:remote": "node scripts/build-remote-bundles.mjs",
    "check:remote-bundles": "node scripts/build-remote-bundles.mjs --check",
    "test:opencode-tui": "bun test packages/opencode-plugin/test/tui-runtime.test.ts",
    "audit:high": "npm audit --audit-level=high",
    "odw": "node packages/daemon/src/cli.js",
    "start": "node packages/daemon/src/cli.js start",
    "stop": "node packages/daemon/src/cli.js stop",
    "status": "node packages/daemon/src/cli.js status",
    "setup": "node scripts/setup.mjs",
    "smoke:hosts": "node scripts/smoke-agent-hosts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "c8": "^10.1.3",
    "eslint": "^9.39.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
